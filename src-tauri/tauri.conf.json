{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lumen",
  "version": "0.4.8",
  "identifier": "com.lumen.media",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "lumen",
        "minHeight": 600,
        "minWidth": 800,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Lumen",
        "url": "/splash",
        "width": 400,
        "height": 480,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**",
            "$DOCUMENT/**",
            "$HOME/**"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzOTFERTNDOUY2QzlFMTgKUldRWW5teWZQTjZSczM1am9kSlg0UzNEbFl4Z1RLa1hkT2xKNk0zaE5QSXZwTVUvK2l3dVVRYXYK",
      "endpoints": [
        "https://github.com/Lumen-media/lumen/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
